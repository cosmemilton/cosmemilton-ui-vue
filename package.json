    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",

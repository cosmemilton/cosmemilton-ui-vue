{
  "name": "@cosmemilton/ui-vue",
  "version": "0.1.10",
  "license": "ISC",
  "description": "Componentes Vue 3 e Nuxt da CosmeMilton UI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuxt": "./dist/nuxt.js",
